<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.

PublishUrl comes from $(ApiDeployDir) in the repository's Directory.Build.props, so this
profile and `deploy.proj` always publish to the same place. Override it with
-p:ApiDeployDir=... or -p:SiteRoot=... rather than editing the path here.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <DeleteExistingFiles>False</DeleteExistingFiles>
    <ExcludeApp_Data>False</ExcludeApp_Data>
    <LaunchSiteAfterPublish>False</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishProvider>FileSystem</PublishProvider>
    <!--
      Visual Studio's FileSystem publish reads PublishUrl; `dotnet publish` reads PublishDir
      and ignores PublishUrl entirely. Both are set, to the same place, so publishing from
      the IDE and from the command line cannot drift apart. PublishDir needs the trailing
      separator.
    -->
    <PublishUrl>$(ApiDeployDir)</PublishUrl>
    <PublishDir>$(ApiDeployDir)\</PublishDir>
    <WebPublishMethod>FileSystem</WebPublishMethod>
  </PropertyGroup>
</Project>
