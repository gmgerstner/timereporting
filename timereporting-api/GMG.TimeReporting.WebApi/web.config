<?xml version="1.0" encoding="utf-8"?>
<!--
  The publish pipeline merges the handlers and aspNetCore elements into this file, so what
  ships to the server is this content plus the AspNetCoreModuleV2 mapping. Only the parts
  that cannot be generated belong here.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!--
          This API is an IIS sub-application of the UI's site, and IIS copies the parent
          site's rewrite rules into every child application. The UI's catch-all SPA rule
          (anything that is not a file goes to "/") would then swallow every API request:
          inside this application the rules are matched against the URL relative to the
          application root, so "/api/Authentication/Login" arrives as
          "Authentication/Login", which slips past the parent's "^api/" guard and falls
          straight into the catch-all. This clear drops the inherited rules before any of
          them run.

          The UI's own web.config wraps its rules in a location element that stops the
          inheritance at the source. This is the second half of that belt: it holds even
          against an older copy of the UI still sitting on the server.
        -->
        <clear />
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
